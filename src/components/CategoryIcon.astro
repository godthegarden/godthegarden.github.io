---
interface Props {
  type:
    | 'dev'
    | 'ctf'
    | 'bug-bounty'
    | 'tech-wrt'
    | 'research'
    | 'activities';
}

const { type } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="category-svg"
  aria-hidden="true"
>
  {
    type === 'dev' && (
      <>
        <path d="m8 7-5 5 5 5" />
        <path d="m16 7 5 5-5 5" />
        <path d="m14 4-4 16" />
      </>
    )
  }

  {
    type === 'ctf' && (
      <>
        <rect x="2" y="3" width="20" height="18" rx="2" />
        <path d="m6 8 4 4-4 4" />
        <path d="M12 16h6" />
      </>
    )
  }

  {
    type === 'bug-bounty' && (
      <>
        <path d="M12 2 20 6v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4Z" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }

  {
    type === 'tech-wrt' && (
      <>
        <path d="M7 2h7l5 5v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" />
        <path d="M14 2v5h5" />
        <path d="m10 12-2 2 2 2" />
        <path d="m14 12 2 2-2 2" />
      </>
    )
  }

  {
    type === 'research' && (
      <>
        <path d="m10 3 3 3" />
        <path d="m11 2 4 4" />
        <path d="m7 7 4 4" />
        <path d="m13 6-5 5" />
        <path d="m8 11-2 2" />
        <path d="M13 12a5 5 0 1 1-5 5" />
        <path d="M4 22h16" />
        <path d="M12 22v-2" />
      </>
    )
  }

  {
    type === 'activities' && (
      <>
        <circle cx="12" cy="8" r="5" />
        <path d="m8.5 12-2 9 5.5-3 5.5 3-2-9" />
        <path d="m10 8 1.4 1.4L14 6.8" />
      </>
    )
  }
</svg>

<style>
  .category-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>