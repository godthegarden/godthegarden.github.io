---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';

const interests = [
  'Cybersecurity',
  'Artificial Intelligence',
  'Cloud & Infrastructure',
  'Mobility Security',
];
---

<BaseLayout title="About">
  <section class="shell about">
    <Header page="ABOUT" />

    <div class="content">
      <div class="intro">
        <h1 class="about-title">About.</h1>

        <!-- Personal Information -->
        <div class="identity">
          <div class="info-field">
            <p class="field-label">NAME</p>
            <h2 class="name">Jeong Won Shin</h2>
          </div>

          <div class="info-field">
            <p class="field-label">SCHOOL</p>
            <p class="field-value">
              Korea University Sejong Campus
            </p>
          </div>

          <div class="info-field">
            <p class="field-label">MAJOR</p>
            <p class="field-value">
              AI and Cybersecurity
            </p>
          </div>

          <div class="info-field">
            <p class="field-label">NOTE</p>
            <p class="note">
              Learning by building, breaking, and
              understanding how things work.
            </p>
          </div>
        </div>

        <!-- Interests -->
        <section
          class="info-section"
          aria-labelledby="interests-title"
        >
          <h3 class="section-title" id="interests-title">
            Interests
          </h3>

          <div class="interests">
            {
              interests.map((interest) => (
                <span class="interest">{interest}</span>
              ))
            }
          </div>
        </section>

        <!-- Contact -->
        <section
          class="info-section"
          aria-labelledby="contact-title"
        >
          <h3 class="section-title" id="contact-title">
            Contact
          </h3>

          <SocialLinks variant="labeled" showRSS={false} />
        </section>
      </div>

      <!-- Profile Image -->
      <aside class="profile">
        <img
          src="/images/cat-avatar.jpg"
          alt="Black and white cat looking directly at the camera"
          width="280"
          height="280"
          loading="eager"
        />
      </aside>
    </div>

    <!-- Footer -->
    <footer class="footer about-footer">
      <a href="/">← Back to Home</a>

      <div class="photo-credit">
        Avatar photo by 
        <a
          href="https://unsplash.com/@getslower"
          target="_blank"
          rel="noopener noreferrer"
        > Andrii Solok </a>
        on
        <a
          href="https://unsplash.com/photos/xqEmWoY541A"
          target="_blank"
          rel="noopener noreferrer"
        > Unsplash </a>.
      </div>
    </footer>
  </section>
</BaseLayout>

<style>
  .about {
    background: #202329;
  }

  /* LAYOUT */

  .content {
    flex: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 280px);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(45px, 7vh, 85px) 0;
  }

  .intro {
    max-width: 720px;
  }

  /* ABOUT TITLE */

  .about-title {
    margin: 0;
    color: #a6bad7;
    font-family: monospace;
    font-size: clamp(18px, 1.65vw, 24px);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  /* PERSONAL INFORMATION */

  .identity {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 30px;
  }

  .info-field {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .field-label {
    margin: 0;
    color: #9ba7b8;
    font-family: monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  .name {
    margin: 0;
    color: #f0f0ed;
    font-size: clamp(36px, 4vw, 58px);
    font-weight: 600;
    line-height: 1.13;
    letter-spacing: -0.045em;
  }

  .field-value {
    margin: 0;
    color: #e0e4e9;
    font-size: 17px;
    line-height: 1.6;
  }

  .note {
    margin: 0;
    max-width: 570px;
    color: #b2b8c1;
    font-size: 16px;
    line-height: 1.8;
  }

  /* INTERESTS & CONTACT */

  .info-section {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1px solid #3a4049;
  }

  .section-title {
    margin: 0 0 20px;
    color: #e5e7eb;
    font-size: 17px;
    font-weight: 600;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .interest {
    display: inline-block;
    padding: 9px 13px;
    color: #cbd5e1;
    background: #2b3038;
    border: 1px solid #414955;
    font-size: 13px;
    line-height: 1.4;
  }

  /* CAT IMAGE */

  .profile {
    width: 100%;
    max-width: 280px;
    justify-self: end;
    align-self: center;

    /* Shift photo slightly to the left */
    transform: translateX(-40px);
  }

  .profile img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(100%);
  }

  /* FOOTER */

  .about-footer {
    gap: 24px;
  }

  .photo-credit {
    color: #929ba8;
    font-size: 12px;
    line-height: 1.6;
    text-align: right;
  }

  .photo-credit a {
    color: #b9c5d6;
    text-decoration: underline;
    text-decoration-color: #626d7a;
    text-underline-offset: 3px;
  }

  /* RESPONSIVE */

  @media (max-width: 850px) {
    .content {
      grid-template-columns: minmax(0, 1fr) minmax(160px, 220px);
      gap: 28px;
    }

    .profile {
      max-width: 220px;
      transform: translateX(-15px);
    }
  }

  @media (max-width: 650px) {
    .content {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 44px 0;
    }

    .identity {
      margin-top: 26px;
    }

    .name {
      font-size: clamp(34px, 8vw, 46px);
    }

    .field-value {
      font-size: 16px;
    }

    .note {
      font-size: 15px;
    }

    .profile {
      max-width: 220px;
      justify-self: start;
      transform: none;
    }

    .about-footer {
      align-items: flex-start;
    }

    .photo-credit {
      text-align: left;
    }
  }
</style>