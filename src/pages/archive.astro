---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('blog', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.publishedAt.getTime() -
    a.data.publishedAt.getTime()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title="Archive">
  <section class="shell archive">
    <Header page="ARCHIVE" />

    <div class="content">
      <p class="eyebrow">
        WRITING / ALL POSTS
      </p>

      <h1 class="archive-title">
        Archive.
      </h1>

      <p class="intro">
        All notes, projects, and experiences in one place.
      </p>

      <div class="post-list">
        {
          posts.length > 0 ? (
            posts.map((post) => (
              <a
                class="post-row"
                href={`/posts/${post.id}/`}
              >
                <time
                  datetime={post.data.publishedAt.toISOString()}
                >
                  {formatDate(post.data.publishedAt)}
                </time>

                <div class="post-info">
                  <h2>{post.data.title}</h2>

                  <span class="category">
                    {post.data.category}
                  </span>
                </div>

                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          ) : (
            <p class="empty-state">
              No published posts yet.
            </p>
          )
        }
      </div>
    </div>

    <footer class="footer">
      <a href="/">
        ← Back to Home
      </a>

      <span>
        {posts.length}
        {' '}
        {posts.length === 1 ? 'post' : 'posts'}
      </span>
    </footer>
  </section>
</BaseLayout>

<style>
  /* PAGE */

  .archive {
    background: #202329;
  }

  .content {
    flex: 1;
    padding: 70px 0;
  }

  /* HEADING */

  .archive-title {
    font-size: clamp(44px, 5vw, 76px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.055em;
    margin: 14px 0 20px;
  }

  .intro {
    margin: 0;
    color: #a4a9b0;
    font-size: 16px;
    line-height: 1.6;
  }

  /* POST LIST */

  .post-list {
    margin-top: 60px;
    border-top: 1px solid #444a53;
  }

  .post-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 24px;

    padding: 24px 0;
    border-bottom: 1px solid #444a53;

    transition: color 0.2s ease;
  }

  .post-row:hover {
    color: #a6bad7;
  }

  .post-row:focus-visible {
    outline: 2px solid #a6bad7;
    outline-offset: 4px;
  }

  /* DATE */

  time {
    font-size: 13px;
    color: #a4a9b0;
    white-space: nowrap;
  }

  /* POST DETAILS */

  .post-info {
    min-width: 0;
  }

  .post-info h2 {
    font-size: 19px;
    line-height: 1.45;
    font-weight: 500;
    margin: 0 0 8px;
  }

  .category {
    font-family: monospace;
    font-size: 12px;
    color: #a6bad7;
  }

  .arrow {
    color: #a6bad7;
    font-size: 19px;
  }

  .empty-state {
    margin: 0;
    padding: 30px 0;
    color: #a4a9b0;
    font-size: 14px;
  }

  /* RESPONSIVE */

  @media (max-width: 650px) {
    .content {
      padding: 50px 0;
    }

    .post-list {
      margin-top: 40px;
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr) 24px;
      gap: 12px;
    }

    time {
      grid-column: 1 / -1;
    }

    .post-info h2 {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-row {
      transition: none;
    }
  }
</style>