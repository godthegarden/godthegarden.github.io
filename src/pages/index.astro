---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('blog', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.publishedAt.getTime() -
    a.data.publishedAt.getTime()
);

const recentPosts = posts.slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title="Home">
  <section class="shell home">
    <Header />

    <div class="hero">
      <div class="hero-content">
        <p class="hero-eyebrow">
          CARTHEGARDEN? NO, NO.
        </p>

        <h1 class="hero-title">
          Godthegarden.
        </h1>

        <nav class="navigation" aria-label="Main navigation">
          <a class="nav-link" href="/categories/">
            Categories <span aria-hidden="true">↗</span>
          </a>

          <a class="nav-link" href="/archive/">
            Archive <span aria-hidden="true">↗</span>
          </a>

          <a class="nav-link" href="/about/">
            About <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </div>

    <section class="recent" aria-labelledby="recent-title">
      <h2 id="recent-title" class="section-heading">
        RECENT WRITING
      </h2>

      <div class="recent-list">
        {
          recentPosts.length > 0 ? (
            recentPosts.map((post, index) => (
              <a
                class="recent-card"
                href={`/posts/${post.id}/`}
                style={`--card-delay: ${index * 100}ms`}
              >
                <div class="recent-card-content">
                  <h3>{post.data.title}</h3>

                  {post.data.description && (
                    <p class="post-description">
                      {post.data.description}
                    </p>
                  )}

                  <div class="post-meta">
                    <span class="post-category">
                      {post.data.category.replaceAll('-', ' ')}
                    </span>

                    <time
                      datetime={post.data.publishedAt.toISOString()}
                    >
                      {formatDate(post.data.publishedAt)}
                    </time>
                  </div>
                </div>
              </a>
            ))
          ) : (
            <div class="recent-empty">
              <p>No posts yet.</p>
            </div>
          )
        }
      </div>
    </section>

    <footer class="footer home-footer">
      <SocialLinks />
    </footer>
  </section>
</BaseLayout>

<style>
  .home {
    background: #17191d;
  }

  /* HERO */

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 65px 0 70px;
  }

  .hero-content {
    --eyebrow-size: clamp(20px, 3.1vw, 48px);
    max-width: 1200px;
  }

  .hero-eyebrow {
    margin: 0 0 20px;
    color: #9ba7b8;
    font-family: monospace;
    font-size: var(--eyebrow-size);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .hero-title {
    margin: 0;
    font-size: calc(var(--eyebrow-size) * 1.6);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  /* NAVIGATION */

  .navigation {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 34px;
    margin-top: 46px;
    font-size: 16px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid #626871;

    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-link:hover {
    color: #a6bad7;
    border-color: #a6bad7;
  }

  /* RECENT WRITING */

  .recent {
    border-top: 1px solid #393d43;
    padding: 26px 0 30px;
  }

  .section-heading {
    margin: 0 0 20px;
    color: #d8dce2;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .recent-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .recent-card {
    display: block;
    min-width: 0;
    background: #22262c;
    border: 1px solid #30353d;
    padding: 20px 24px;

    opacity: 0;
    animation: card-enter 0.55s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
    animation-delay: var(--card-delay);

    transition:
      background 0.22s ease,
      border-color 0.22s ease,
      transform 0.22s ease;
  }

  .recent-card:hover {
    background: #2a3038;
    border-color: #586a80;
    transform: translateY(-2px);
  }

  .recent-card:focus-visible {
    outline: 2px solid #a6bad7;
    outline-offset: 3px;
  }

  .recent-card h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.45;
  }

  .post-description {
    margin: 10px 0 0;
    color: #a4a9b0;
    font-size: 14px;
    line-height: 1.6;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 15px;
    color: #98a2ae;
    font-size: 12px;
  }

  .post-category {
    color: #a6bad7;
    text-transform: capitalize;
  }

  .recent-empty {
    padding: 20px 24px;
    border: 1px solid #30353d;
    color: #989da5;
    font-size: 14px;
  }

  .recent-empty p {
    margin: 0;
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* FOOTER */

  .home-footer {
    justify-content: flex-start;
    padding-top: 20px;
  }

  /* RESPONSIVE */

  @media (max-width: 700px) {
    .hero {
      padding: 70px 0;
    }

    .hero-content {
      --eyebrow-size: clamp(16px, 4vw, 28px);
    }

    .navigation {
      gap: 20px;
      margin-top: 34px;
      font-size: 15px;
    }

    .recent-card {
      padding: 18px;
    }

    .recent-card h3 {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recent-card {
      opacity: 1;
      animation: none;
    }

    .recent-card,
    .nav-link {
      transition: none;
    }
  }
</style>