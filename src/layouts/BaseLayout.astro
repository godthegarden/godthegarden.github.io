---
import { ClientRouter } from 'astro:transitions';
import type { TransitionDirectionalAnimations } from 'astro';

import CosmicBackdrop from '../components/CosmicBackdrop.astro';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Godthegarden',
  description = 'A personal technical archive.',
} = Astro.props;

const pageTitle =
  title === 'Home' || title === 'Godthegarden'
    ? 'Godthegarden'
    : `${title} | Godthegarden`;

const pathname = Astro.url.pathname;

const isHome = pathname === '/';
const isCategories = /^\/categories\/?$/.test(pathname);
const isCategoryDetail = /^\/categories\/[^/]+\/?$/.test(pathname);
const isArchive = /^\/archive\/?$/.test(pathname);
const isAbout = /^\/about\/?$/.test(pathname);

const showCosmic =
  isHome ||
  isCategories ||
  isCategoryDetail ||
  isArchive ||
  isAbout;

const cosmicScene:
  | 'saturn'
  | 'earth'
  | 'blackhole'
  | 'meteors'
  | 'stars' =
    isHome ? 'saturn'
    : isCategories ? 'earth'
    : isArchive ? 'blackhole'
    : isAbout ? 'meteors'
    : 'stars';

const expand: TransitionDirectionalAnimations = {
  forwards: {
    old: {
      name: 'page-exit',
      duration: '0.35s',
      easing: 'ease-in',
    },
    new: {
      name: 'page-expand',
      duration: '0.65s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
    },
  },
  backwards: {
    old: {
      name: 'page-exit',
      duration: '0.35s',
      easing: 'ease-in',
    },
    new: {
      name: 'page-expand',
      duration: '0.65s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
    },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#202329" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Godthegarden RSS"
      href="/rss.xml"
    />

    <title>{pageTitle}</title>

    <script is:inline>
      (function () {
        let preference = 'system';

        try {
          const stored = localStorage.getItem('godthegarden-theme');
          if (
            stored === 'light' ||
            stored === 'dark' ||
            stored === 'system'
          ) {
            preference = stored;
          }
        } catch {
          preference = 'system';
        }

        const systemDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches;

        document.documentElement.dataset.theme =
          preference === 'system'
            ? (systemDark ? 'dark' : 'light')
            : preference;

        document.documentElement.dataset.themePreference =
          preference;
      })();
    </script>

    <ClientRouter />
  </head>

  <body>
    <main
      class="page"
      transition:name="page-content"
      transition:animate={expand}
    >
      {showCosmic && <CosmicBackdrop scene={cosmicScene} />}
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .page {
    width: 100%;
    min-height: 100vh;
  }

  .shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding:
      clamp(24px, 3vw, 48px)
      clamp(24px, 5vw, 80px);
  }

  .eyebrow {
    color: var(--accent);
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 22px 0;
    border-top: 1px solid var(--border-soft);
    color: var(--text-muted);
    font-size: 12px;
  }

  .footer a:hover {
    color: var(--link-hover);
  }

  @media (max-width: 600px) {
    .shell {
      padding: 24px;
    }
  }

  @keyframes page-expand {
    from {
      opacity: 0;
      transform: scale(.975);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes page-exit {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.015);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>